{
	"apiVersion": 3,
	"title": "EHRI Project Front Page Resource block",
	"name": "ehriproject/front-page-resource",
	"category": "media",
	"icon": "smiley",
	"keywords": ["ehri", "project"],
	"attributes": {
		"imageUrl": {
			"type": "string",
			"default": ""
		},
		"imageId": {
			"type": "number"
		},
		"imageAlt": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": "Welcome to Our Site"
		},
		"description": {
			"type": "string",
			"default": "Discover amazing content and resources."
		},
		"linkUrl": {
			"type": "string",
			"default": ""
		},
		"linkText": {
			"type": "string",
			"default": "Learn More"
		},
		"alignment": {
			"type": "string",
			"default": "center"
		}
	},
	"supports": {
		"html": false,
		"align": ["wide", "full"],
		"spacing": {
			"margin": true,
			"padding": true
		},
		"color": {
			"background": true,
			"text": true
		}
	},
	"example": {
		"attributes": {
			"title": "Featured Section",
			"description": "This is an example of how your hero section will look.",
			"linkText": "Get Started"
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:../../style.css"
}
