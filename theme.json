{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"layout": {
			"contentSize": "60rem",
			"wideSize": "90rem"
		},
		"color": {
			"custom": true,
			"customDuotone": true,
			"customGradient": true,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"slug": "wine-red",
					"color": "#6C003B",
					"name": "Wine Red"
				},
				{
					"slug": "wine-red-highlight",
					"color": "#980756",
					"name": "Wine Red Highlight"
				},
				{
					"slug": "purple",
					"color": "#472C56",
					"name": "Purple"
				},
				{
					"slug": "purple-light",
					"color": "#F7F3FF",
					"name": "Purple Light"
				},
				{
					"slug": "grey-lighter",
					"color": "#F1F1F1",
					"name": "Grey Lighter"
				},
				{
					"slug": "grey-light",
					"color": "#EDEAEE",
					"name": "Grey Light"
				},
				{
					"slug": "grey-dark",
					"color": "#46463D",
					"name": "Grey Dark"
				},
				{
					"slug": "grey-darker",
					"color": "#3B3B3B",
					"name": "Grey Darker"
				},
				{
					"slug": "beige",
					"color": "#DAD7BE",
					"name": "Beige"
				},
				{
					"slug": "white",
					"color": "#FFFFFF",
					"name": "White"
				},
				{
					"slug": "black",
					"color": "#46463D",
					"name": "Black"
				}
			],
			"gradients": [
				{
					"slug": "beige-light",
					"gradient": "linear-gradient(0deg, rgba(213, 210, 184, 0.2), rgba(213, 210, 184, 0.2)), #FFFFFF",
					"name": "Beige Light"
				}
			]
		},
		"typography": {
			"lineHeight": true,
			"customFontSize": true,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": false,
			"textDecoration": true,
			"textTransform": true,
			"fontFamilies": [
				{
					"fontFamily": "\"Barlow\", sans-serif",
					"name": "Barlow",
					"slug": "barlow",
					"fontFace": [
						{
							"fontFamily": "Barlow",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": [
								"file:./fonts/barlow-v12-latin_latin-ext-regular.woff2",
								"file:./fonts/barlow-v12-latin_latin-ext-regular.woff"
							]
						},
						{
							"fontFamily": "Barlow",
							"fontWeight": "500",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": [
								"file:./fonts/barlow-v12-latin_latin-ext-500.woff2",
								"file:./fonts/barlow-v12-latin_latin-ext-500.woff"
							]
						},
						{
							"fontFamily": "Barlow",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": [
								"file:./fonts/barlow-v12-latin_latin-ext-700.woff2",
								"file:./fonts/barlow-v12-latin_latin-ext-700.woff"
							]
						}
					]
				},
				{
					"fontFamily": "\"Noto Serif\", serif",
					"name": "Noto Serif",
					"slug": "noto-serif",
					"fontFace": [
						{
							"fontFamily": "Noto Serif",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": [
								"file:./fonts/noto-serif-v21-cyrillic_cyrillic-ext_greek_greek-ext_latin_latin-ext-regular.woff2",
								"file:./fonts/noto-serif-v21-cyrillic_cyrillic-ext_greek_greek-ext_latin_latin-ext-regular.woff"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"name": "Extra Small",
					"slug": "x-small",
					"size": "0.625rem"
				},
				{
					"name": "Small",
					"slug": "small",
					"size": "0.875rem"
				},
				{
					"name": "Base",
					"slug": "base",
					"size": "1rem"
				},
				{
					"name": "Medium",
					"slug": "medium",
					"size": "1.125rem"
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "1.25rem"
				},
				{
					"name": "Extra Large",
					"slug": "x-large",
					"size": "1.75rem"
				},
				{
					"name": "Title",
					"slug": "title",
					"size": "2.5rem"
				}
			]
		},
		"spacing": {
			"customSpacingSize": true,
			"spacingSizes": [
				{
					"name": "Small",
					"slug": "small",
					"size": "0.5rem"
				},
				{
					"name": "Medium",
					"slug": "medium",
					"size": "1rem"
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "1.5rem"
				},
				{
					"name": "Extra Large",
					"slug": "x-large",
					"size": "2rem"
				}
			],
			"units": ["px", "em", "rem", "vh", "vw", "%"]
		},
		"custom": {
			"spacing": {
				"small": "0.5rem",
				"medium": "1rem",
				"large": "1.5rem",
				"extraLarge": "2rem"
			},
			"fontWeight": {
				"regular": "400",
				"bold": "500",
				"bolder": "600"
			},
			"borderRadius": {
				"input": "0.25rem",
				"inputLarge": "0.5rem",
				"card": "0.5rem"
			},
			"breakpoints": {
				"tablet": "576px",
				"laptop": "1024px",
				"wide": "1440px"
			},
			"layout": {
				"maxPageWidth": "90rem",
				"maxContentWidth": "60rem"
			},
			"logo": {
				"widthSmall": "16rem",
				"widthMedium": "20rem",
				"widthLarge": "24rem"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--purple)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--barlow)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.5"
		},
		"spacing": {
			"padding": {
				"top": "0",
				"right": "0",
				"bottom": "0",
				"left": "0"
			},
			"margin": {
				"top": "0",
				"right": "0",
				"bottom": "0",
				"left": "0"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--wine-red)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--wine-red-highlight)"
					}
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--barlow)",
					"fontSize": "var(--wp--preset--font-size--title)",
					"lineHeight": "3rem"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--barlow)",
					"fontSize": "1.875rem",
					"lineHeight": "2.25rem"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--barlow)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.5rem"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--barlow)",
					"fontSize": "1.375rem",
					"lineHeight": "1.5rem"
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--barlow)",
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--barlow)",
					"fontSize": "var(--wp--preset--font-size--base)"
				}
			},
			"button": {
				"border": {
					"radius": "0.25rem",
					"width": "2px",
					"style": "solid",
					"color": "var(--wp--preset--color--wine-red)"
				},
				"color": {
					"background": "var(--wp--preset--color--wine-red)",
					"text": "var(--wp--preset--color--white)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--barlow)",
					"fontWeight": "500",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"lineHeight": "1.35rem"
				},
				"spacing": {
					"padding": {
						"top": "1rem",
						"right": "1.5rem",
						"bottom": "1rem",
						"left": "1.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--wine-red-highlight)",
						"text": "var(--wp--preset--color--white)"
					},
					"border": {
						"color": "var(--wp--preset--color--wine-red-highlight)"
					}
				}
			}
		}
	}
}
