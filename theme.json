{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"layout": {
			"contentSize": "1024px",
			"wideSize": "1440px"
		},
		"typography": {
			"lineHeight": false,
			"customFontSize": true,
			"fontFamilies": [
				{
					"fontFamily": "\"Barlow\", sans-serif",
					"name": "Barlow",
					"slug": "barlow",
					"fontFace": [
						{
							"fontFamily": "Barlow",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontStretch": "normal",
							"src": [
								"file:./fonts/barlow-v12-latin_latin-ext-regular.woff2",
								"file:./fonts/barlow-v12-latin_latin-ext-regular.woff"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"name": "Small",
					"slug": "small",
					"size": "0.875rem"
				},
				{
					"name": "Medium",
					"slug": "medium",
					"size": "1.125rem"
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "1.25rem"
				},
				{
					"name": "Extra Large",
					"slug": "x-large",
					"size": "1.75rem"
				}
			]
		}
	}
}
